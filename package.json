{
  "name": "sk8l",
  "version": "0.21.0",
  "private": true,
  "scripts": {
    "serve": "vite preview",
    "build": "vite build",
    "dev": "vite",
    "test": "vitest",
    "test-sa": "vitest --standalone",
    "test-cov": "vitest --coverage",
    "lint": "eslint --ext .js,.vue --ignore-path .gitignore",
    "serveprod": "pm2 serve --no-daemon dist 1337",
    "type-check": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@achrinza/node-ipc": "^10.1.11",
    "@bufbuild/protobuf": "^2.16.0",
    "@connectrpc/connect": "^2.3.0",
    "@connectrpc/connect-web": "^2.3.0",
    "@primer/octicons": "^19.42.0",
    "@testing-library/vue": "^8.1.0",
    "@vitest/coverage-v8": "^5.0.5",
    "cronstrue": "^3.38.0",
    "factory-girl-ts": "^2.3.1",
    "happy-dom": "^21.0.4",
    "luxon": "^3.7.2",
    "rollup": "^4.67.4",
    "shiki": "^4.5.0",
    "simple-statistics": "^7.8.3",
    "uplot": "^1.6.32",
    "vitest": "^5.0.5",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.6",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.14.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-vue": "^10.9.0",
    "eslint-plugin-vuejs-accessibility": "^2.5.0",
    "sass": "^1.99.0",
    "typescript": "^6.0.3",
    "vite": "^7.3.1",
    "vue-eslint-parser": "^10.4.2",
    "vue-tsc": "^3.3.14"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true,
      "es2022": true
    },
    "extends": [
      "plugin:vue/vue3-essential",
      "@vue/airbnb",
      "@vue/eslint-config-typescript"
    ],
    "parserOptions": {},
    "rules": {
      "no-unused-vars": [
        "error",
        {
          "argsIgnorePattern": "^_",
          "varsIgnorePattern": "^_",
          "args": "all"
        }
      ]
    },
    "overrides": [
      {
        "files": [
          "**/__tests__/*.{j,t}s?(x)",
          "**/tests/unit/**/*.spec.{j,t}s?(x)"
        ],
        "env": {},
        "rules": {}
      }
    ]
  },
  "browserslist": [
    "last 2 versions",
    "not ie 11"
  ],
  "packageManager": "yarn@4.2.2"
}
